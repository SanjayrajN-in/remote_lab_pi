[Unit]
Description=Virtual Lab - Audio Streaming Service (Lab-Pi)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=__PROJECT_DIR__/Audio
ExecStart=__PROJECT_DIR__/venv/bin/python3 __PROJECT_DIR__/Audio/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment=PYTHONUNBUFFERED=1

# Hardening
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
